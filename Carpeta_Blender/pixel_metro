import bpy
import numpy as np
import csv

# ─────────────────────────────────────────────────────────────────
# CONFIGURACIÓN
# ─────────────────────────────────────────────────────────────────
RUTA_SALIDA = r"C:\ensayo correcto TFG\datasetcorrecto1000frames\camara_matrices.csv"

# ─────────────────────────────────────────────────────────────────
# OBTENER CÁMARA Y ESCENA
# ─────────────────────────────────────────────────────────────────
escena = bpy.context.scene
cam_obj = escena.camera
cam_data = cam_obj.data

res_x = escena.render.resolution_x * escena.render.resolution_percentage / 100
res_y = escena.render.resolution_y * escena.render.resolution_percentage / 100

# ─────────────────────────────────────────────────────────────────
# MATRIZ INTRÍNSECA K
# ─────────────────────────────────────────────────────────────────
sensor_width  = cam_data.sensor_width
sensor_height = cam_data.sensor_height
focal_length  = cam_data.lens   # en mm

# Si el sensor_fit es AUTO, Blender usa sensor_width para ambos ejes
# y ajusta según el aspect ratio de la resolución
if cam_data.sensor_fit == 'VERTICAL':
    sensor_height_eff = sensor_height
    sensor_width_eff  = sensor_height * (res_x / res_y)
else:
    sensor_width_eff  = sensor_width
    sensor_height_eff = sensor_width * (res_y / res_x)

f_x = (focal_length / sensor_width_eff)  * res_x
f_y = (focal_length / sensor_height_eff) * res_y

c_x = res_x / 2.0
c_y = res_y / 2.0

print("=" * 50)
print("MATRIZ INTRÍNSECA K")
print("=" * 50)
print(f"f_x = {f_x:.6f}")
print(f"f_y = {f_y:.6f}")
print(f"c_x = {c_x:.6f}")
print(f"c_y = {c_y:.6f}")
print(f"\nResolución: {res_x:.0f} x {res_y:.0f} px")
print(f"Focal length: {focal_length:.4f} mm")
print(f"Sensor width: {sensor_width:.4f} mm")
print(f"Sensor height: {sensor_height:.4f} mm")

# ─────────────────────────────────────────────────────────────────
# MATRIZ EXTRÍNSECA [R|T]
# Blender usa matrix_world de la cámara, que da la posición de la
# CÁMARA en el mundo. Para [R|T] necesitamos la inversa: la posición
# del MUNDO respecto a la cámara (convención OpenCV/visión)
# ─────────────────────────────────────────────────────────────────

# Matriz mundo de la cámara (4x4) en convención Blender
mat_world = cam_obj.matrix_world

# Convención Blender: cámara mira hacia -Z, Y hacia arriba
# Convención OpenCV: cámara mira hacia +Z, Y hacia abajo
# Hay que rotar 180° en X para pasar de Blender a OpenCV
R_blender_to_cv = np.array([
    [1,  0,  0],
    [0, -1,  0],
    [0,  0, -1]
])

# Extraer rotación y traslación de matrix_world (Blender: cámara→mundo)
mat_world_np = np.array(mat_world)
R_cam_to_world = mat_world_np[:3, :3]
t_cam_to_world = mat_world_np[:3, 3]

# Aplicar corrección de convención
R_cam_to_world_cv = R_cam_to_world @ R_blender_to_cv

# Invertir para obtener mundo→cámara (lo que necesita la ecuación de proyección)
R_world_to_cam = R_cam_to_world_cv.T
t_world_to_cam = -R_world_to_cam @ t_cam_to_world

print("\n" + "=" * 50)
print("MATRIZ EXTRÍNSECA [R|T]  (mundo → cámara)")
print("=" * 50)
print("R =")
print(R_world_to_cam)
print("\nT =")
print(t_world_to_cam)

# ─────────────────────────────────────────────────────────────────
# GUARDAR EN CSV
# ─────────────────────────────────────────────────────────────────
with open(RUTA_SALIDA, 'w', newline='') as f:
    writer = csv.writer(f)
    writer.writerow(["parametro", "valor"])
    writer.writerow(["f_x", f_x])
    writer.writerow(["f_y", f_y])
    writer.writerow(["c_x", c_x])
    writer.writerow(["c_y", c_y])
    writer.writerow(["r_11", R_world_to_cam[0,0]])
    writer.writerow(["r_12", R_world_to_cam[0,1]])
    writer.writerow(["r_13", R_world_to_cam[0,2]])
    writer.writerow(["r_21", R_world_to_cam[1,0]])
    writer.writerow(["r_22", R_world_to_cam[1,1]])
    writer.writerow(["r_23", R_world_to_cam[1,2]])
    writer.writerow(["r_31", R_world_to_cam[2,0]])
    writer.writerow(["r_32", R_world_to_cam[2,1]])
    writer.writerow(["r_33", R_world_to_cam[2,2]])
    writer.writerow(["t_1", t_world_to_cam[0]])
    writer.writerow(["t_2", t_world_to_cam[1]])
    writer.writerow(["t_3", t_world_to_cam[2]])
    writer.writerow(["res_x", res_x])
    writer.writerow(["res_y", res_y])

print(f"\n✅ Matrices guardadas en: {RUTA_SALIDA}")
